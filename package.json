{
  "name": "opportunity-concierge",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "postinstall": "patch-package",
    "dev": "next dev",
    "build": "next build",
    "lint": "eslint .",
    "convex": "convex dev",
    "typecheck": "tsc --noEmit",
    "test": "rm -rf .test-build && tsc --target ES2022 --module commonjs --moduleResolution node --esModuleInterop --skipLibCheck --strict --outDir .test-build --noEmit false tests/policy.test.ts lib/analysisPolicy.ts lib/mailPolicy.ts && node --test .test-build/tests/policy.test.js && rm -rf .test-build",
    "deploy": "npx @convex-dev/static-hosting deploy --dist out --build-command \"npm run build:static\"",
    "build:static": "node scripts/build-static.mjs"
  },
  "dependencies": {
    "@agentmail/convex": "^0.1.0",
    "@convex-dev/static-hosting": "^0.2.1",
    "@firecrawl/firecrawl-convex": "^0.1.1",
    "convex": "^1.45.0",
    "convex-helpers": "^0.1.122",
    "next": "^15.5.2",
    "openai": "^5.19.1",
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "^15.5.2",
    "patch-package": "^8.0.1",
    "typescript": "^5.9.2"
  }
}
